# --- Server ---
PORT=4000
NODE_ENV=development
BASE_URL=http://localhost:4000

# --- Persistence ---
# SQLite file holding conversations, messages, and customer memory. Survives
# process restarts/redeploys. Use an absolute path in production so it isn't
# lost if the working directory changes.
DATABASE_PATH=./data/app.db

# --- AmoCRM OAuth app (Marketplace integration) ---
# Created at https://www.amocrm.ru/developers/content/oauth/step-by-step
AMOCRM_SUBDOMAIN=your-subdomain
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=http://localhost:4000/api/amocrm/oauth/callback
# Long-lived token storage (filled in automatically after first OAuth exchange)
AMOCRM_ACCESS_TOKEN=
AMOCRM_REFRESH_TOKEN=

# --- rf-dveri.ru catalog access ---
# YML (Yandex Market) product export feed — no auth required, refreshed on a TTL.
CATALOG_BASE_URL=https://rf-dveri.ru
CATALOG_FEED_URL=https://www.rf-dveri.ru/admin/exchange/get_export/4998349/?as_file=0
CATALOG_FEED_TTL_MS=1800000

# --- LLM provider (Director / Sales / Material Expert reasoning) ---
LLM_PROVIDER=mock
# Anthropic Claude (recommended when a key is available)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Voice / OCR ---
STT_PROVIDER=mock
OCR_PROVIDER=mock

# --- Telegram (manager notifications, optional) ---
TELEGRAM_BOT_TOKEN=
